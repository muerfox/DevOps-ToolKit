[Unit]
Description=DevOps Cockpit
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Edit these two to match your install:
User=devops
WorkingDirectory=/opt/DevOps-ToolKit
EnvironmentFile=/opt/DevOps-ToolKit/.env
# systemd's own default PATH is narrower than an interactive login shell's
# and doesn't always include every place Docker/kubectl/etc. get installed
# (e.g. some distros put Docker under /usr/local/bin, or use snap's PATH).
# `docker`/`kubectl`/`git` not being found here is exactly what shows up as
# "No such file or directory" in a pipeline step -- if that happens, check
# `which docker` (etc.) as the User= above and add its directory here.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/DevOps-ToolKit/.venv/bin/python /opt/DevOps-ToolKit/run.py
Restart=on-failure
RestartSec=5

# The cockpit runs as User= above, not root -- that account needs to
# actually be in the `docker` group (or have equivalent permission on
# /var/run/docker.sock) for the Docker/Swarm pages and any pipeline steps
# that talk to Docker to work: `sudo usermod -aG docker devops`.

[Install]
WantedBy=multi-user.target
