# Copy this file to .env and edit before running the cockpit
# (or just run `./cockpit init`, which does it for you and fills in the secrets).

# How ./cockpit runs the app: "docker" (docker compose) or "local" (Python venv).
COCKPIT_MODE=

# Signs the session cookie. MUST be set to a long random string in production.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
COCKPIT_SECRET_KEY=change-me-to-a-random-secret

# Fernet key used to encrypt stored credentials (SSH keys/passwords, Jenkins
# tokens, git credentials) at rest in the database.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, a key is auto-generated on first run and stored at data/secret.key
# (included in ./cockpit backup; set this explicitly if you manage secrets elsewhere).
COCKPIT_ENCRYPTION_KEY=

# Default local Docker connection used by the built-in "local" docker host.
DOCKER_HOST=unix:///var/run/docker.sock

# Timezone used to evaluate pipeline cron schedules, e.g. Europe/Berlin.
TZ=

# Port published on the host (docker mode) / listened on (local mode uses PORT).
COCKPIT_PORT=8000
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Public URL of the cockpit, used when showing webhook URLs
# (e.g. https://cockpit.example.com). Defaults to the URL in your browser.
COCKPIT_PUBLIC_URL=

# Set to false to disable cron-scheduled pipeline runs on this instance.
COCKPIT_SCHEDULER=true

# How many backups `./cockpit backup` keeps in backups/.
COCKPIT_BACKUP_KEEP=10
