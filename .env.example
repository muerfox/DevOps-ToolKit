# Copy this file to .env and edit before running the cockpit.

# Signs the session cookie. MUST be set to a long random string in production.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
COCKPIT_SECRET_KEY=change-me-to-a-random-secret

# Fernet key used to encrypt stored credentials (SSH keys/passwords, Jenkins
# tokens, git credentials) at rest in the database.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, a key is auto-generated on first run and stored at data/secret.key
# (fine for local/dev use; set this explicitly for anything persistent).
COCKPIT_ENCRYPTION_KEY=

# Default local Docker connection used by the built-in "local" docker host.
DOCKER_HOST=unix:///var/run/docker.sock

HOST=0.0.0.0
PORT=8000
DEBUG=false
